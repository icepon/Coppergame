<!DOCTYPE html>
<html lang="th">
<head>
  <meta charset="UTF-8">
  <meta name="viewport" content="width=device-width, initial-scale=1.0">
  <title>Paw Patrol Pontificator</title>
  <style>
    * {
      box-sizing: border-box;
      user-select: none;
      -webkit-user-select: none;
    }
    body {
      margin: 0;
      background: #1e1e24;
      display: flex;
      justify-content: center;
      align-items: center;
      min-height: 100vh;
      font-family: 'Courier New', monospace;
    }
    #game-container {
      position: relative;
      width: 440px;
      height: 600px;
      border: 4px solid #111;
      border-radius: 12px;
      overflow: hidden;
      box-shadow: 0 12px 30px rgba(0,0,0,0.6);
      background: #8e9eab;
    }
    canvas {
      display: block;
      width: 100%;
      height: 100%;
      image-rendering: pixelated;
    }
    .touch-controls {
      position: absolute;
      bottom: 15px;
      left: 0;
      width: 100%;
      display: flex;
      justify-content: space-between;
      padding: 0 25px;
      pointer-events: none;
    }
    .btn {
      pointer-events: auto;
      background: rgba(255, 255, 255, 0.9);
      border: 3px solid #222;
      border-radius: 10px;
      font-size: 26px;
      font-weight: bold;
      width: 65px;
      height: 52px;
      display: flex;
      align-items: center;
      justify-content: center;
      cursor: pointer;
      box-shadow: 0 4px #111;
    }
    .btn:active {
      transform: translateY(3px);
      box-shadow: 0 1px #111;
      background: #ffd154;
    }
  </style>
</head>
<body>

<div id="game-container">
  <canvas id="gameCanvas" width="440" height="600"></canvas>
  <div class="touch-controls">
    <button class="btn" id="btn-left">◀</button>
    <button class="btn" id="btn-right">▶</button>
  </div>
</div>

<script>
const canvas = document.getElementById('gameCanvas');
const ctx = canvas.getContext('2d');

// --- Web Audio API Synth (เสียงสังเคราะห์แบบ 8-bit โดยไม่ต้องพึ่งไฟล์นอก) ---
let audioCtx = null;
function initAudio() {
  if (!audioCtx) audioCtx = new (window.AudioContext || window.webkitAudioContext)();
}

function playSound(type) {
  if (!audioCtx) return;
  const now = audioCtx.currentTime;

  if (type === 'bone') {
    // เสียงเก็บกระดูก Ding-Dong
    const osc = audioCtx.createOscillator();
    const gain = audioCtx.createGain();
    osc.type = 'triangle';
    osc.frequency.setValueAtTime(523.25, now); // C5
    osc.frequency.setValueAtTime(783.99, now + 0.08); // G5
    gain.gain.setValueAtTime(0.3, now);
    gain.gain.exponentialRampToValueAtTime(0.01, now + 0.25);
    osc.connect(gain);
    gain.connect(audioCtx.destination);
    osc.start(now);
    osc.stop(now + 0.25);
  } else if (type === 'crash') {
    // เสียงชนอึ Splat/Crash ต่ำๆ
    const osc = audioCtx.createOscillator();
    const gain = audioCtx.createGain();
    osc.type = 'sawtooth';
    osc.frequency.setValueAtTime(160, now);
    osc.frequency.exponentialRampToValueAtTime(30, now + 0.35);
    gain.gain.setValueAtTime(0.4, now);
    gain.gain.exponentialRampToValueAtTime(0.01, now + 0.35);
    osc.connect(gain);
    gain.connect(audioCtx.destination);
    osc.start(now);
    osc.stop(now + 0.35);
  } else if (type === 'bark') {
    // เสียงเห่าสั้นๆ
    const osc = audioCtx.createOscillator();
    const gain = audioCtx.createGain();
    osc.type = 'square';
    osc.frequency.setValueAtTime(350, now);
    osc.frequency.exponentialRampToValueAtTime(180, now + 0.12);
    gain.gain.setValueAtTime(0.2, now);
    gain.gain.exponentialRampToValueAtTime(0.01, now + 0.12);
    osc.connect(gain);
    gain.connect(audioCtx.destination);
    osc.start(now);
    osc.stop(now + 0.12);
  }
}

// --- Game Variables ---
let state = 'PLAY';
let score = 0;
let level = 1;
let speed = 4;
let frameCount = 0;
let shakeTime = 0;

const dog = {
  x: 220,
  y: 480,
  speed: 6.5,
  moveLeft: false,
  moveRight: false
};

const poops = [];
const bones = [];
const particles = [];
const floatingTexts = [];

let poopSpawnTimer = 0;
let boneSpawnTimer = 0;

// วาดฉากทางเดิน
function drawEnvironment() {
  ctx.fillStyle = '#8f9fa9';
  ctx.fillRect(0, 0, canvas.width, canvas.height);

  // ขอบตึกซ้าย-ขวา
  ctx.fillStyle = '#c5a089';
  ctx.fillRect(0, 0, 30, canvas.height);
  ctx.fillRect(canvas.width - 30, 0, 30, canvas.height);

  // เส้นตารางทางเท้า
  ctx.strokeStyle = '#76858e';
  ctx.lineWidth = 2;
  const tileOffset = (frameCount * speed) % 60;
  for (let y = -60; y < canvas.height; y += 60) {
    ctx.beginPath();
    ctx.moveTo(30, y + tileOffset);
    ctx.lineTo(canvas.width - 30, y + tileOffset);
    ctx.stroke();
  }

  // ขอบฟุตบาท
  ctx.strokeStyle = '#374149';
  ctx.lineWidth = 4;
  ctx.strokeRect(30, -5, canvas.width - 60, canvas.height + 10);
}

// วาดน้องหมา French Bulldog
function drawFrenchie(x, y, frame) {
  ctx.save();
  ctx.translate(x, y);

  const bob = Math.sin(frame * 0.35) * 3;

  // หูทรงค้างคาว (Bat Ears)
  ctx.fillStyle = '#e88ba5';
  ctx.fillRect(-22, -34 + bob, 12, 20);
  ctx.fillRect(10, -34 + bob, 12, 20);
  ctx.strokeStyle = '#1e1e24';
  ctx.lineWidth = 3.5;
  ctx.strokeRect(-22, -34 + bob, 12, 20);
  ctx.strokeRect(10, -34 + bob, 12, 20);

  // ลำตัวลายวัว (Pied)
  ctx.fillStyle = '#f8f8f8';
  ctx.fillRect(-20, -10 + bob, 40, 32);
  ctx.fillStyle = '#222';
  ctx.fillRect(-20, -6 + bob, 18, 20);

  // ขาและแอนิเมชั่นวิ่ง
  const legOffset = Math.sin(frame * 0.45) * 6;
  ctx.fillStyle = '#f8f8f8';
  ctx.fillRect(-22, 18 + legOffset, 12, 14);
  ctx.fillRect(10, 18 - legOffset, 12, 14);

  // หัวสีดำพร้อมแถบขาวตรงกลาง
  ctx.fillStyle = '#222';
  ctx.fillRect(-24, -26 + bob, 48, 28);
  ctx.fillStyle = '#ffffff';
  ctx.fillRect(-6, -26 + bob, 12, 28);

  // หน้าสั้นและปาก
  ctx.fillStyle = '#ffffff';
  ctx.fillRect(-14, -8 + bob, 28, 16);
  ctx.fillStyle = '#111';
  ctx.fillRect(-5, -6 + bob, 10, 6);

  // ลิ้นห้อย
  ctx.fillStyle = '#ff5b79';
  ctx.fillRect(-4, 2 + bob, 8, 5);

  // ตาโต
  ctx.fillStyle = '#000';
  ctx.fillRect(-16, -18 + bob, 6, 8);
  ctx.fillRect(10, -18 + bob, 6, 8);
  ctx.fillStyle = '#fff';
  ctx.fillRect(-14, -18 + bob, 2, 3);
  ctx.fillRect(12, -18 + bob, 2, 3);

  ctx.restore();
}

// วาดกองอึหมา
function drawPoop(p) {
  ctx.save();
  ctx.translate(p.x, p.y);
  ctx.fillStyle = '#6a3805';
  ctx.beginPath();
  ctx.roundRect(-p.w / 2, 0, p.w, 14, [6]);
  ctx.fill();

  ctx.fillStyle = '#7a4209';
  ctx.beginPath();
  ctx.roundRect(-p.w / 2 + 5, -10, p.w - 10, 12, [5]);
  ctx.fill();

  ctx.fillStyle = '#8a4c0d';
  ctx.beginPath();
  ctx.arc(0, -13, 5, 0, Math.PI * 2);
  ctx.fill();
  ctx.restore();
}

// วาดไอเทมกระดูก (Bone)
function drawBone(b) {
  ctx.save();
  ctx.translate(b.x, b.y);
  ctx.fillStyle = '#ffffff';
  ctx.strokeStyle = '#333';
  ctx.lineWidth = 2;

  // แกนกลาง
  ctx.fillRect(-12, -4, 24, 8);
  ctx.strokeRect(-12, -4, 24, 8);

  // ปุ่มหัวกระดูก
  [-12, 12].forEach(ox => {
    [-4, 4].forEach(oy => {
      ctx.beginPath();
      ctx.arc(ox, oy, 5, 0, Math.PI * 2);
      ctx.fillStyle = '#ffffff';
      ctx.fill();
      ctx.stroke();
    });
  });
  ctx.restore();
}

// วาด UI หน้าปัด & คะแนน
function drawUI() {
  ctx.fillStyle = 'rgba(255, 255, 255, 0.95)';
  ctx.fillRect(12, 12, 130, 48);
  ctx.fillRect(canvas.width - 142, 12, 130, 48);
  ctx.strokeStyle = '#111';
  ctx.lineWidth = 3;
  ctx.strokeRect(12, 12, 130, 48);
  ctx.strokeRect(canvas.width - 142, 12, 130, 48);

  ctx.fillStyle = '#111';
  ctx.font = 'bold 12px Courier New';
  ctx.fillText('SCORE:', 20, 30);
  ctx.font = 'bold 18px Courier New';
  ctx.fillText(String(Math.floor(score)).padStart(5, '0'), 20, 50);

  ctx.font = 'bold 12px Courier New';
  ctx.fillText('LEVEL:', canvas.width - 134, 30);
  ctx.font = 'bold 18px Courier New';
  ctx.fillText(`LVL ${level}`, canvas.width - 134, 50);

  // Speedometer
  const gx = canvas.width - 50;
  const gy = 105;
  ctx.beginPath();
  ctx.arc(gx, gy, 28, 0, Math.PI * 2);
  ctx.fillStyle = '#1e1e24';
  ctx.fill();
  ctx.strokeStyle = '#fff';
  ctx.lineWidth = 2;
  ctx.stroke();

  const angle = -Math.PI * 0.8 + (Math.min(speed, 18) / 18) * Math.PI * 1.6;
  ctx.beginPath();
  ctx.moveTo(gx, gy);
  ctx.lineTo(gx + Math.cos(angle) * 22, gy + Math.sin(angle) * 22);
  ctx.strokeStyle = '#ff3b30';
  ctx.lineWidth = 3;
  ctx.stroke();
}

function update() {
  if (state === 'PLAY') {
    frameCount++;
    score += speed * 0.04;

    // ความยากเพิ่มตามความเร็ว
    speed = 4.5 + Math.floor(score / 120) * 1.1;
    level = 1 + Math.floor(score / 250);

    // ฝุ่นใต้เท้าน้องหมา
    if (frameCount % 4 === 0) {
      particles.push({
        x: dog.x + (Math.random() * 24 - 12),
        y: dog.y + 28,
        r: 3 + Math.random() * 3,
        alpha: 1
      });
    }

    // เลื่อนตำแหน่งน้องหมา
    if (dog.moveLeft && dog.x > 55) dog.x -= dog.speed;
    if (dog.moveRight && dog.x < canvas.width - 55) dog.x += dog.speed;

    // สุ่มเสกอึ
    poopSpawnTimer++;
    const poopInterval = Math.max(22, 65 - level * 4);
    if (poopSpawnTimer >= poopInterval) {
      poopSpawnTimer = 0;
      poops.push({
        x: 60 + Math.random() * (canvas.width - 120),
        y: -30,
        w: 32 + Math.random() * 8,
        h: 22
      });
    }

    // สุ่มเสกกระดูกโบนัส
    boneSpawnTimer++;
    if (boneSpawnTimer >= 140) {
      boneSpawnTimer = 0;
      bones.push({
        x: 65 + Math.random() * (canvas.width - 130),
        y: -30
      });
    }

    // ตรวจสอบกระดูก
    for (let i = bones.length - 1; i >= 0; i--) {
      const b = bones[i];
      b.y += speed;

      if (Math.hypot(dog.x - b.x, dog.y - b.y) < 32) {
        score += 50;
        playSound('bone');
        floatingTexts.push({ x: b.x, y: b.y, text: '+50', alpha: 1 });
        bones.splice(i, 1);
        continue;
      }
      if (b.y > canvas.height + 40) bones.splice(i, 1);
    }

    // ตรวจสอบกองอึ (Collision Detection)
    for (let i = poops.length - 1; i >= 0; i--) {
      const p = poops[i];
      p.y += speed;

      if (Math.hypot(dog.x - p.x, (dog.y - 8) - p.y) < 27) {
        playSound('crash');
        shakeTime = 20;
        state = 'GAMEOVER';
      }
      if (p.y > canvas.height + 40) poops.splice(i, 1);
    }
  }

  // อัปเดตฝุ่น
  for (let i = particles.length - 1; i >= 0; i--) {
    particles[i].y += speed * 0.4;
    particles[i].alpha -= 0.05;
    if (particles[i].alpha <= 0) particles.splice(i, 1);
  }

  // ข้อความลอย +50
  for (let i = floatingTexts.length - 1; i >= 0; i--) {
    floatingTexts[i].y -= 1.5;
    floatingTexts[i].alpha -= 0.03;
    if (floatingTexts[i].alpha <= 0) floatingTexts.splice(i, 1);
  }

  if (shakeTime > 0) shakeTime--;
}

function draw() {
  ctx.save();
  // Screen Shake effect เวลาชน
  if (shakeTime > 0) {
    const ox = (Math.random() - 0.5) * 10;
    const oy = (Math.random() - 0.5) * 10;
    ctx.translate(ox, oy);
  }

  ctx.clearRect(0, 0, canvas.width, canvas.height);
  drawEnvironment();

  // วาดฝุ่น
  particles.forEach(pt => {
    ctx.fillStyle = `rgba(220, 220, 220, ${pt.alpha})`;
    ctx.beginPath();
    ctx.arc(pt.x, pt.y, pt.r, 0, Math.PI * 2);
    ctx.fill();
  });

  // วาดสิ่งกีดขวาง & ของสะสม
  bones.forEach(b => drawBone(b));
  poops.forEach(p => drawPoop(p));
  drawFrenchie(dog.x, dog.y, frameCount);

  // วาดข้อความคะแนนลอย
  floatingTexts.forEach(ft => {
    ctx.fillStyle = `rgba(255, 230, 0, ${ft.alpha})`;
    ctx.font = 'bold 20px Courier New';
    ctx.fillText(ft.text, ft.x - 15, ft.y);
  });

  drawUI();

  if (state === 'GAMEOVER') {
    ctx.fillStyle = 'rgba(0, 0, 0, 0.7)';
    ctx.fillRect(0, 0, canvas.width, canvas.height);

    ctx.fillStyle = '#ffcc00';
    ctx.textAlign = 'center';
    ctx.font = 'bold 30px Courier New';
    ctx.fillText('GAME OVER!', canvas.width / 2, 270);

    ctx.fillStyle = '#fff';
    ctx.font = '16px Courier New';
    ctx.fillText(`Final Score: ${Math.floor(score)}`, canvas.width / 2, 310);
    ctx.fillText('Tap Screen or Press SPACE', canvas.width / 2, 350);
    ctx.textAlign = 'start';
  }
  ctx.restore();
}

function loop() {
  update();
  draw();
  requestAnimationFrame(loop);
}

function resetGame() {
  initAudio();
  playSound('bark');
  score = 0;
  level = 1;
  speed = 4.5;
  dog.x = 220;
  poops.length = 0;
  bones.length = 0;
  state = 'PLAY';
}

// ควบคุมด้วยคีย์บอร์ด
window.addEventListener('keydown', (e) => {
  initAudio();
  if (e.code === 'ArrowLeft' || e.code === 'KeyA') dog.moveLeft = true;
  if (e.code === 'ArrowRight' || e.code === 'KeyD') dog.moveRight = true;
  if (e.code === 'Space' && state === 'GAMEOVER') resetGame();
});

window.addEventListener('keyup', (e) => {
  if (e.code === 'ArrowLeft' || e.code === 'KeyA') dog.moveLeft = false;
  if (e.code === 'ArrowRight' || e.code === 'KeyD') dog.moveRight = false;
});

// ควบคุมด้วยปุ่มบนหน้าจอ
const leftBtn = document.getElementById('btn-left');
const rightBtn = document.getElementById('btn-right');

['pointerdown', 'touchstart'].forEach(evt => {
  leftBtn.addEventListener(evt, (e) => { e.preventDefault(); initAudio(); dog.moveLeft = true; });
  rightBtn.addEventListener(evt, (e) => { e.preventDefault(); initAudio(); dog.moveRight = true; });
});

['pointerup', 'touchend', 'pointercancel'].forEach(evt => {
  leftBtn.addEventListener(evt, () => dog.moveLeft = false);
  rightBtn.addEventListener(evt, () => dog.moveRight = false);
});

canvas.addEventListener('click', () => {
  initAudio();
  if (state === 'GAMEOVER') resetGame();
});

loop();
</script>
</body>
</html>
